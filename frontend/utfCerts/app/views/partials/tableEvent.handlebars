{{#each this}}
	<tr>
		<td class="col-check">
			<input name="checkboxDownload" class="form-check-input is-show" type="checkbox" id="{{code}}" aria-label="Selecionar certificado de {{owner}}">
		</td>
		<td>
			<a href="https://apl.utfpr.edu.br/extensao/certificados/validar/{{code}}" target="_blank" rel="noopener noreferrer" class="cert-link">
				<span>{{owner}}</span>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
			</a>
		</td>
	</tr>
{{else}}
	<tr>
		<td colspan="2" class="empty-cell">Ainda não há certificados emitidos neste evento.</td>
	</tr>
{{/each}}
